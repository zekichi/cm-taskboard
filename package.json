{
  "name": "cm-taskboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "nodemon --watch server --ext js,json --exec \"node server/src/index.js\"",
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "build:client": "vite build",
    "build:server": "prisma generate --schema server/prisma/schema.prisma",
    "build": "npm run build:server && npm run build:client",
    "start": "npm run prisma:deploy && npm run start:server",
    "start:server": "node server/src/index.js",
    "start:prod": "npm run start",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "prisma:seed": "node server/prisma/seed.js",
    "seed:prod": "node server/prisma/seed.js",
    "deploy:db": "npm run prisma:deploy && npm run seed:prod",
    "db:setup": "npm run prisma:migrate -- --name init && npm run prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.10",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.18",
    "vite": "^6.0.11"
  }
}
